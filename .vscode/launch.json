{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AgdaProver Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "timeout": 30000,
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/editor/vscode"
      ],
      "outFiles": []
    }
  ]
}
