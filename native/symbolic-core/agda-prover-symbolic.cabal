cabal-version: 3.0
name: agda-prover-symbolic
version: 0.1.0.0
synopsis: Typed symbolic engine boundaries for AgdaProver
license: GPL-3.0-or-later
build-type: Simple

common defaults
  default-language: Haskell2010
  ghc-options: -Wall -Werror
  build-depends: base ==4.18.*, aeson ==2.2.4.1

library
  import: defaults
  hs-source-dirs: core
  exposed-modules:
    AgdaProver.Symbolic.Protocol,
    AgdaProver.Symbolic.SessionTypes,
    AgdaProver.Symbolic.Evidence,
    AgdaProver.Symbolic.Clause,
    AgdaProver.Symbolic.Classification,
    AgdaProver.Symbolic.Focused,
    AgdaProver.Symbolic.Algebra,
    AgdaProver.Symbolic.Refutation,
    AgdaProver.Symbolic.Agenda,
    AgdaProver.Symbolic.NNUE.Hash,
    AgdaProver.Symbolic.NNUE.Model,
    AgdaProver.Symbolic.NNUE.Sparse,
    AgdaProver.Symbolic.NNUE.Score,
    AgdaProver.Symbolic.NNUE.Cache,
    AgdaProver.Symbolic.NNUE.Native,
    AgdaProver.Symbolic.NNUE.Features,
    AgdaProver.Symbolic.NNUE.Policy
  build-depends:
    containers >=0.6 && <0.7,
    bytestring ==0.11.5.4,
    text >=2.0 && <2.1,
    vector >=0.13 && <0.14,
    cryptohash-sha256 ==0.11.102.1,
    blake2 ==0.3.0.1,
    mtl >=2.3 && <2.4
  if !os(windows)
    build-depends: unix >=2.8 && <2.9

library agda28
  import: defaults
  hs-source-dirs: adapter
  exposed-modules: AgdaProver.Agda28.Observation, AgdaProver.Agda28.Session,
    AgdaProver.Agda28.AgendaExecution, AgdaProver.Agda28.AgendaSearch
  other-modules: Structure, Decode, Atoms, StructureAnnotations,
    AgdaProver.Agda28.EvidenceSearch, AgdaProver.Agda28.Construction,
    AgdaProver.Agda28.Clauses, AgdaProver.Agda28.ClauseExecution,
    AgdaProver.Agda28.Recursion, AgdaProver.Agda28.Scheduling,
    AgdaProver.Agda28.Focused, AgdaProver.Agda28.Helpers,
    AgdaProver.Agda28.HelperConstruction, AgdaProver.Agda28.DraftAssembly,
    AgdaProver.Agda28.Source, AgdaProver.Agda28.Algebra,
    AgdaProver.Agda28.Refutation, AgdaProver.Agda28.Dependencies,
    AgdaProver.Agda28.PolicyViews, AgdaProver.Agda28.ObservedEquations,
    AgdaProver.Agda28.SearchTask
  build-depends:
    agda-prover-symbolic,
    Agda ==2.8.0,
    containers >=0.6 && <0.7,
    mtl >=2.3 && <2.4,
    transformers >=0.6 && <0.7,
    text >=2.0 && <2.1,
    vector >=0.13 && <0.14,
    bytestring ==0.11.5.4,
    directory >=1.3 && <1.4,
    random ==1.3.1

executable agdaprover-symbolic
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: SessionProtocol, RunControl
  ghc-options: -threaded -rtsopts
  build-depends:
    agda-prover-symbolic,
    agda-prover-symbolic:agda28,
    Agda ==2.8.0,
    bytestring ==0.11.5.4,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.5,
    containers >=0.6 && <0.7
