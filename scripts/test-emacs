#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if command -v agda >/dev/null 2>&1; then
  agda_mode_file=$(agda --emacs-mode=locate)
  agda_mode_dir=$(dirname -- "$agda_mode_file")
  set -- -L "$agda_mode_dir"
else
  set --
fi
exec emacs -Q --batch "$@" -L "$repo_root/editor" \
  --eval '(setq load-prefer-newer t)' \
  -l "$repo_root/editor/test/agdaprover-test.el" -f ert-run-tests-batch-and-exit
